    "action": "$description = json_decode((string) @HM_GetParamsetDescription($_IPS['TARGET']), true);\nif (!is_array($description) || !isset($description['ALL_LEDS'])) {\n    echo (strncmp(IPS_GetSystemLanguage(), 'de', 2) == 0) ? 'Das Ziel hat keine Funktion zum Setzen aller LEDs.' : 'This target has no function to set all LEDs.';\n    return;\n}\n$value = 0;\nfor ($led = 1; $led <= 16; $led++) {\n    $value |= (((int) $_IPS['LED' . $led]) & 3) << (2 * ($led - 1));\n}\nHM_WriteValueString($_IPS['TARGET'], 'ALL_LEDS', (string) $value);",

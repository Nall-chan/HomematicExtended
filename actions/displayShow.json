    "action": "$de = strncmp(IPS_GetSystemLanguage(), 'de', 2) == 0;\n$description = json_decode((string) @HM_GetParamsetDescription($_IPS['TARGET']), true);\nif (!is_array($description) || !isset($description['TEXT'], $description['SUBMIT'])) {\n    echo $de ? 'Das Ziel ist nicht der Kanal DISPLAY einer Fernbedienung mit Display.' : 'The target is not the DISPLAY channel of a remote control with display.';\n    return;\n}\n$text = trim($_IPS['TEXT']);\nif ((strpos($text, '.') !== false) || (strpos($text, ',') !== false)) {\n    $text = substr($text, 0, 6);\n} else {\n    $text = substr($text, 0, 5);\n    if (is_numeric($text)) {\n        $text = str_pad($text, 5, ' ', STR_PAD_LEFT);\n    }\n}\nHM_WriteValueString($_IPS['TARGET'], 'TEXT', $text);\nHM_WriteValueInteger($_IPS['TARGET'], 'UNIT', $_IPS['UNIT']);\nHM_WriteValueInteger($_IPS['TARGET'], 'BEEP', $_IPS['BEEP']);\nHM_WriteValueInteger($_IPS['TARGET'], 'BACKLIGHT', $_IPS['BACKLIGHT']);\nHM_WriteValueInteger($_IPS['TARGET'], 'ALARM_COUNT', $_IPS['ALARM_COUNT']);\nHM_WriteValueInteger($_IPS['TARGET'], 'SERVICE_COUNT', $_IPS['SERVICE_COUNT']);\nforeach (['BULB', 'SWITCH', 'WINDOW', 'DOOR', 'BLIND', 'SCENE', 'PHONE', 'BELL', 'CLOCK', 'ARROW_UP', 'ARROW_DOWN'] as $symbol) {\n    if ($_IPS[$symbol]) {\n        HM_WriteValueBoolean($_IPS['TARGET'], $symbol, true);\n    }\n}\nHM_WriteValueBoolean($_IPS['TARGET'], 'SUBMIT', true);",
    "locale": {

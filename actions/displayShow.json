    "caption": "Show on display",
    "description": "Shows text, unit, symbols, beep and backlight on the display of a remote control with display (HM-RC-19). The target is the instance of the DISPLAY channel (channel 18). The form shows a hint for other targets.",
    "form": [
        "$description = json_decode((string) @HM_GetParamsetDescription($_IPS['TARGET']), true);",
        "if (!is_array($description) || !isset($description['TEXT'], $description['SUBMIT'])) {",
        "    return [",
        "        ['type' => 'Label', 'caption' => 'This target is not the DISPLAY channel of a remote control with display.'],",
        "        ['type' => 'Label', 'caption' => 'Choose the instance of channel 18 (DISPLAY) of an HM-RC-19, HM-RC-19-B or HM-RC-19-SW.']",
        "    ];",
        "}",
        "return [",
        "    [",
        "        'type' => 'ValidationTextBox',",
        "        'name' => 'TEXT',",
        "        'caption' => 'Text',",
        "        'value' => ''",
        "    ],",
        "    [",
        "        'type' => 'Select',",
        "        'name' => 'UNIT',",
        "        'caption' => 'Unit',",
        "        'options' => [",

        "            ],",
        "            [",
        "                'caption' => 'Tone 1',",
        "                'value' => 1",
        "            ],",
        "            [",
        "                'caption' => 'Tone 2',",
        "                'value' => 2",
        "            ],",
        "            [",
        "                'caption' => 'Tone 3',",
        "                'value' => 3",
        "            ]",
        "        ],",
        "        'value' => 0",
        "    ],",
        "    [",
        "        'type' => 'Select',",
